# The build stage runs `npm ci` from package-lock.json, so a node_modules
# tree from the host is 94 MB of context that is thrown away — and worse,
# one built against a different platform than the node:20-alpine builder.
node_modules/
dist/

# Never bake local configuration into an image: the backend URL comes from
# the VITE_API_URL build arg, not from whatever this machine was pointed at.
.env
.env.*

.git/
.gitignore
.dockerignore
*.log
.vscode/
.idea/
.DS_Store
