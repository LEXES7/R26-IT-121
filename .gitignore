# ============================================================
# DeepSentinel — VAE-With-DSAA .gitignore
# R26-IT-121 | IT22109194 | Wijesinghe L P D B
# ============================================================

# Redundant .py versions (notebooks are the source of truth for VAE-With-DSAA).
# Scoped to that component on purpose: as a repo-wide rule this silently
# dropped every NEW .py added anywhere, while edits to already-tracked files
# kept working — so the breakage was invisible. GraphSage and fusion_engine
# are Python packages, not notebook exports.
VAE-With-DSAA/**/*.py

# PDF files (proposal, spec docs — too large, not code)
*.pdf

# Data files (too large for GitHub — stored in Google Drive)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv

# Saved models and results (too large — stored in Google Drive)
results/*
models/*
DeepSentinel-VAE-Results/
!results/.gitkeep
!models/.gitkeep
*.keras
*.h5
*.pkl
*.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db
